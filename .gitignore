# The executable PackageCompiler writes, at the repository root: a package
# directory holds a Project.toml and a src/, and nothing a build produced.
build/
# Generated by build_executable (the checked-in AppConfig.default.jl is the fallback)
source/executable/AppConfig.jl
*.log

# Generated cost-weight calibration cache (analyze-session.jl)
session/history/.cost-weight

# Local-only baseline reference screenshots (third-party docs captures)
asset/image/baseline-shadcn/

# Transient agent worktrees (Claude Code isolation)
.claude/worktrees/

# Local cache and memories of the serena MCP server.
.serena/

# Per-package manifests — generated when a package's own directory is activated
# as an environment (julia --project=package/ProjecturedJsonTest); the canonical
# dev env is environment/all (whose Manifest.toml stays tracked).
package/*/Manifest.toml

# Generated run output (vector files, plots) — never source.
results/

# Allocation profiles that julia --track-allocation writes next to each source
# file it loads. The name holds the process id of that run.
*.mem

# Coverage reports that julia --code-coverage writes next to each source file
# it loads. The name holds the process id of that run.
*.cov

# The workload level is a person's choice, not the project's.
LocalPreferences.toml

# juliac trim probe working copies (bench/juliac-trim/sealed.sh setup)
bench/juliac-trim/SealedCompiler2/
bench/juliac-trim/sealed-juliac2/
bench/juliac-trim/env2/
bench/juliac-trim/work*/
