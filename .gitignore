package/executable/build
# Generated by build_executable (the checked-in AppConfig.default.jl is the fallback)
package/executable/main/AppConfig.jl
*.log

# Generated cost-weight calibration cache (analyze-session.jl)
session/history/.cost-weight

# Local-only baseline reference screenshots (third-party docs captures)
asset/image/baseline-shadcn/

# Transient agent worktrees (Claude Code isolation)
.claude/worktrees/

# Per-package test/example env manifests — generated when running a tier's
# suite from its own env (julia --project=package/<tier>-test); the canonical
# dev env is the repo root project (root Manifest.toml stays tracked).
package/*/test/Manifest.toml
package/*/example/Manifest.toml
