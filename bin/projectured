#!/bin/sh
#
# Run the application, with no build.
#
#     bin/projectured
#     bin/projectured a.json b.md --window=workbench
#     bin/projectured --help
#
# It opens files in a window, with a file navigator and an AI assistant beside
# them.
#
# It runs THROUGH THE CHECKOUT, with no build. `bin/build_projectured` compiles
# the same program; this one runs it from source, so a change can be tried
# without the minutes a build costs. The first start after a change compiles
# what changed.
#
# **With a reactive store, it starts the binary.** When `build/projectured/`
# holds the store that `bin/build_projectured` founds with the reactive Julia,
# and this Julia is the reactive one, the script rebuilds the binary, which
# compiles the edit and no more in seconds, and starts it. Else it runs from
# source and says why, and what the reactive build gives. A start never founds a
# store. It uses the `julia` that it finds on PATH.
#
# **It is the same program and not an imitation.** The build function writes the
# package that a build compiles, and asked with `compile = false` it writes that
# package and stops. There is one `julia_main`, and both reach it.
#
# Every argument goes to the program.
#
root=$(cd "$(dirname "$0")/.." && pwd)
# THE BUILD ENVIRONMENT, and this is the one step the library can not own: it is
# what makes `ProjecturedBuilder` loadable, so it happens before `using` it.
#
# RESOLVE and not `instantiate` alone. `instantiate` notices a DIRECT dependency
# that appears; it does not notice one that appears inside a package the
# manifest already lists.
#
# Done in the SAME process that asks, so it costs no second julia start.
#
# ITS OUTPUT SHOWS ONLY WHEN IT IS SLOW. `run_with_slow_output` holds it for ten
# seconds: a normal start spends about five here and says nothing, and a start
# that installs or compiles says why the wait comes and shows each package as it
# goes. A failure shows its output. The file is included alone, in a module of
# its own, because the builder that holds it is not loadable yet.
answer=$(julia --project="$root/environment/build" -e '
    using Pkg
    launcher = Module()
    Base.include(launcher, ARGS[1])
    start = launcher.run_with_slow_output(; notice = ARGS[2]) do
        Pkg.resolve(); Pkg.instantiate()
        @eval using ProjecturedBuilder
        Base.invokelatest() do
            prepare_program_start!(build_projectured_executable; name = "projectured",
                                   output = joinpath(ARGS[3], "build", "projectured"),
                                   script = "bin/projectured",
                                   build_script = "bin/build_projectured")
        end
    end
    print(stderr, start.notice)
    print(start.kind, "\n", start.path, "\n", start.module_name, "\n")' \
    "$root/source/tool/builder/LauncherOutput.jl" \
    "Preparing projectured: after an install or an update, the first start installs and compiles the packages, which takes some minutes, and a rebuild of the binary takes some seconds." \
    "$root")
[ -n "$answer" ] || exit 1
kind=$(printf '%s\n' "$answer" | sed -n 1p)
path=$(printf '%s\n' "$answer" | sed -n 2p)
module_name=$(printf '%s\n' "$answer" | sed -n 3p)

# The binary takes the threads of a start from source, unless the person chose.
if [ "$kind" = binary ]; then
    JULIA_NUM_THREADS=${JULIA_NUM_THREADS:-auto,2}
    export JULIA_NUM_THREADS
    exec "$path" "$@"
fi
exec julia --threads=auto,2 --project="$path" \
     -e "using $module_name; exit($module_name.julia_main())" -- "$@"
